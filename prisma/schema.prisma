generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model PriceAlert {
  id           String        @id @default(uuid())
  type         AlertType 
  threshold    Float? // Used for 'Price' and 'Volatility'
  duration     Int? // Used for 'Volatility' (hours)
  minPrice     Float? 
  maxPrice     Float?
  createdAt    DateTime      @default(now())
  userId       String
  chatId       String?
  telegramChat TelegramChat? @relation("ChatRelation", fields: [chatId], references: [chatId])
  triggeredAt DateTime?
  lastPriceNotified Float?

}

enum AlertType {
  Price
  Volatility
  Range
}

model TelegramChat {
  id          Int          @id @default(autoincrement())
  userId      String // Reference to the user (could be your Clerk ID)
  chatId      String       @unique // Telegram chat ID for sending alerts
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  priceAlerts PriceAlert[] @relation("ChatRelation")
}